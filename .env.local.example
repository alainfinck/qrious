# Copiez ce fichier en .env.local
PAYLOAD_SECRET=qrious-dev-secret-change-me
DATABASE_URI=postgresql://USER:PASSWORD@HOST:5432/qrious
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# E-mails (mot de passe oublié)
FROM_EMAIL=noreply@qrious.fr
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Scaleway S3 Configuration
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_BUCKET=qrious
S3_REGION=fr-par
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Compte admin initial (scripts/create-admin.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optionnel: false pour forcer les migrations même en local (recommandé avant un deploy)
# PAYLOAD_DATABASE_PUSH=false
