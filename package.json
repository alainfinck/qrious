{
  "name": "qrious",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:mobile": "pnpm --dir mobile start",
    "dev:mobile:web": "pnpm --dir mobile exec expo start --web --port 8081",
    "newqr:build": "node scripts/build-newqr.mjs",
    "editeur:build": "node scripts/build-newqr.mjs",
    "build": "pnpm --dir mobile install --frozen-lockfile && pnpm newqr:build && next build",
    "start": "next start",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "test:db": "tsx scripts/test-postgres.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
